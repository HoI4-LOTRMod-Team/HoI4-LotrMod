guiTypes = {
	@doctrine_track_width = 454 # Includes margin of 30 px to each side, so actual content is 360px
	@doctrine_track_height = 764

	containerWindowType = {
		name = "country_doctrine_view"
		size = { width = 100%% height = 100%% }
